# ==============================================================================
# ZERO-COST EVENT TICKETING & ENTRY MANAGEMENT SYSTEM - CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & EVENT SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_EVENT_NAME="JHOOM '26 — Dance Fest cum Dandiya Night"
NEXT_PUBLIC_EVENT_PRICE=299
NEXT_PUBLIC_ADMIN_SCAN_PIN=1234
ADMIN_SCAN_PIN=1234

# ------------------------------------------------------------------------------
# 2. RAZORPAY PAYMENT GATEWAY
# (Get these from https://dashboard.razorpay.com/app/keys)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere

# Razorpay Webhook Secret (Set up in Razorpay Dashboard -> Settings -> Webhooks)
# Point Webhook URL to: https://yourdomain.com/api/webhook
# Subscribe to event: "payment.captured"
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_passphrase_here

# ------------------------------------------------------------------------------
# 3. SUPABASE CONFIGURATION
# (Get from Supabase Dashboard -> Project Settings -> API)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 5. NODEMAILER / SMTP EMAIL CONFIGURATION
# (Using Gmail App Password: https://myaccount.google.com/apppasswords)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
# For Gmail, generate a 16-character App Password (not your normal Gmail password)
SMTP_PASS=xxxx yyyy zzzz wwww
SMTP_FROM="TAALSYA Conclave <tickets@taalsya.org>"
